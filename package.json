{
  "name": "shuaibyh-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Herramientas de validación para el portafolio público; sin dependencias externas.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:catalog": "node scripts/check-project-catalog.mjs",
    "check": "npm run test && npm run check:links && npm run check:anchors && npm run check:catalog && npm run check:sync && npm run check:images && npm run check:secrets && npm run check:web",
    "check:anchors": "node scripts/check-markdown-anchors.mjs",
    "check:sync": "node scripts/check-portfolio-sync.mjs",
    "check:images": "node scripts/check-markdown-images.mjs",
    "check:secrets": "node scripts/check-public-secrets.mjs",
    "export:csv": "node scripts/export-projects.mjs --format csv",
    "export:md": "node scripts/export-projects.mjs --format md",
    "export:json": "node scripts/export-projects.mjs --format json",
    "stats": "node scripts/project-stats.mjs",
    "preview": "node scripts/serve-portfolio.mjs",
    "check:web": "node scripts/check-web-site.mjs"
  }
}
